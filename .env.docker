# =============================================
# CarXpert Environment Variables
# =============================================
# Copy this file to .env and update the values
# IMPORTANT: Generate secure random values for production!

# Application
NODE_ENV=production
PORT=5000

# Database Configuration
# SECURITY: Change this password! Generate with: openssl rand -hex 16
DB_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD
DATABASE_URL=postgresql://carxpert_user:CHANGE_ME_GENERATE_SECURE_PASSWORD@postgres:5432/carxpert

# Session Secret
# CRITICAL: Generate a secure random key! Use: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_GENERATE_SECURE_RANDOM_KEY

# Google Maps API Key (Optional)
GOOGLE_MAPS_API_KEY=

# Cloudinary Configuration (Optional - for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Configuration (Optional - for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
